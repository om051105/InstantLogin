# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=InstantLogin
APP_VERSION=1.0.0
DEBUG=false

# ─── JWT (CHANGE THIS IN PRODUCTION!) ────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string-at-least-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_secret_change_me
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=instantlogin
MYSQL_PASSWORD=instantlogin_pass
MYSQL_DB=instantlogin

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:8080","http://localhost:3000","http://localhost:5173"]
